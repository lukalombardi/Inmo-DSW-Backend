generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Operation {
  SALE
  RENT
}

enum Currency {
  ARS
  USD
}

enum Role {
  ADMIN
  OPERATOR
}

model Zone {
  id         Int        @id @default(autoincrement())
  name       String
  properties Property[]

  @@map("zones")
}

model PropertyType {
  id          Int        @id @default(autoincrement())
  description String
  properties  Property[]

  @@map("property_types")
}

model User {
  id         Int        @id @default(autoincrement())
  name       String
  email      String     @unique
  password   String
  role       Role       @default(OPERATOR)
  properties Property[]

  @@map("users")
}

model Property {
  id             Int       @id @default(autoincrement())
  rooms          Int
  squareMeters   Decimal   @db.Decimal(10, 2)
  garage         Boolean
  creditEligible Boolean
  description    String    @db.Text
  operation      Operation
  address        String
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  currency       Currency
  price          Decimal   @db.Decimal(12, 2)

  propertyTypeId Int
  propertyType   PropertyType @relation(fields: [propertyTypeId], references: [id])
  zoneId         Int
  zone           Zone         @relation(fields: [zoneId], references: [id])
  userId         Int
  user           User         @relation(fields: [userId], references: [id])

  photos    Photo[]
  inquiries Inquiry[]

  @@map("properties")
}

model Photo {
  id         Int      @id @default(autoincrement())
  url        String
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model Inquiry {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  message    String   @db.Text
  createdAt  DateTime @default(now())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("inquiries")
}
